{
  "name": "browser-dock-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "淘宝直播中控台自动化工具（monorepo）",
  "scripts": {
    "dev": "pnpm -C apps/desktop dev",
    "build": "pnpm -C apps/desktop build",
    "preview": "pnpm -C apps/desktop preview",
    "build:mac": "pnpm -C apps/desktop build:mac",
    "build:win": "pnpm -C apps/desktop build:win",
    "test:chrome-cdp": "pnpm -C apps/desktop test:chrome-cdp",
    "test:executor": "pnpm -C apps/desktop test:executor",
    "test:c48-fixture": "pnpm -C apps/desktop test:c48-fixture",
    "test:c32-fixture": "pnpm -C apps/desktop test:c32-fixture",
    "dev:server": "pnpm -C apps/server dev",
    "build:server": "pnpm -C apps/server build",
    "typecheck:server": "pnpm -C apps/server typecheck",
    "db:generate": "pnpm -C apps/server db:generate",
    "db:migrate": "pnpm -C apps/server db:migrate",
    "server:smoke": "node apps/server/scripts/smoke.mjs",
    "typecheck": "pnpm -C apps/desktop typecheck",
    "lint": "pnpm -C apps/desktop lint"
  }
}
